# ── Production on Vercel + Neon ──
# Connect Neon via Vercel → Storage → Neon (Marketplace). The integration injects these for you:
#   DATABASE_URL            pooled connection (runtime)
#   DATABASE_URL_UNPOOLED   direct connection (migrations, bulk imports)
# so you normally do NOT set them by hand. For any other Postgres, set DATABASE_URL yourself.
DATABASE_URL=postgres://user:password@host-pooler/dbname?sslmode=require
# DATABASE_URL_UNPOOLED=postgres://user:password@host/dbname?sslmode=require
# Login mode only: signs session cookies. Generate: openssl rand -base64 48
AUTH_SECRET=

# ── Authentication mode ──
# (unset) = PROTOTYPE: no sign-in; the home page lets anyone open any user type's portal. Needs no secrets.
#           Use only with synthetic data or behind Vercel Deployment Protection.
# login   = real authentication (username/email + password, sessions, lockout). Then AUTH_SECRET and the
#           RCMS_*_PASSWORD variables below are required.
# RCMS_AUTH_MODE=login

# ── Login mode only: sign-in accounts (read at every deploy by `vercel-build`; the environment is the source of truth) ──
# Login ids are plain usernames: admin, hq, centre, analyst (override with RCMS_<ROLE>_USERNAME if you must).
# An account is only created/updated when its password variable is set. Passwords: ≥ 12 characters and must not
# contain the username. Change the value + redeploy to rotate a password.
RCMS_ADMIN_PASSWORD=
RCMS_HQ_PASSWORD=
RCMS_CENTRE_PASSWORD=
RCMS_ANALYST_PASSWORD=
# Centre ids the "centre" account may see (see the Centres page). Needs the athlete workbook imported first.
RCMS_CENTRE_ACADEMY_IDS=
# Optional: RCMS_ADMIN_USERNAME / RCMS_HQ_USERNAME / RCMS_CENTRE_USERNAME / RCMS_ANALYST_USERNAME, RCMS_<ROLE>_NAME

# ── Optional ──
# Max pooled connections per serverless instance (default 5).
# DB_POOL_MAX=5
# Preview deployments skip database migrations unless this is 1.
# Set it (Preview scope only) when the Neon integration's "branch per preview" is on.
# ALLOW_PREVIEW_MIGRATE=1

# ── Local development ──
# With DATABASE_URL unset, `npm run dev` uses an embedded Postgres (PGlite) in ./.data/pglite.
# To use a real local Postgres instead:  docker compose up -d  and
# DATABASE_URL=postgres://rcms:rcms@localhost:5432/rcms
# PGLITE_DIR=./.data/pglite
# SEED_PASSWORD=Demo-Passw0rd-2026
