# ── Required in production (Vercel → Project → Settings → Environment Variables) ──
# Postgres connection string. Use the *pooled* endpoint (Neon: host contains "-pooler").
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Random secret used to sign session cookies. Generate: openssl rand -base64 48
AUTH_SECRET=

# ── Optional ──
# Max pooled connections per serverless instance (default 5).
# DB_POOL_MAX=5
# Preview deployments skip database migrations unless this is 1
# (set it only when each preview has its own database, e.g. Neon branching).
# ALLOW_PREVIEW_MIGRATE=1

# ── Local development ──
# With DATABASE_URL unset, `npm run dev` uses an embedded Postgres (PGlite) in ./.data/pglite.
# To use a real local Postgres instead:  docker compose up -d  and
# DATABASE_URL=postgres://rcms:rcms@localhost:5432/rcms
# PGLITE_DIR=./.data/pglite
# SEED_PASSWORD=Demo-Passw0rd-2026
